# TaskMarket environment variables
#
# This file documents LOCAL DEVELOPMENT configuration only. The values are safe
# local defaults that point at the Docker Compose services in
# docker-compose.dev.yml. They must never be used in production.
#
# Rules:
# - Only variable names and safe placeholder/default values may ever be added.
# - Never commit real secrets: private keys, seed phrases, API tokens,
#   database passwords, or wallet credentials.
# - Local secret files (.env, .env.local, .env.*) are ignored by .gitignore.
# - `pnpm preflight` runs scripts/check-env.mjs, which refuses NODE_ENV=production
#   and flags anything that looks like a private key in .env.
#
# Development mode (safe, testnet-oriented default).
NODE_ENV=development

# Local PostgreSQL (Docker Compose "postgres" service). Start with `pnpm db:up`.
DATABASE_URL=postgres://taskmarket_dev:taskmarket_dev@localhost:5432/taskmarket_dev

# Local Redis (Docker Compose "redis" service). Used for idempotency, queues,
# and rate limiting in later phases.
REDIS_URL=redis://localhost:6379

# GOAT Network variables (RPC URLs, wallet/key configuration, idempotency
# store, GOAT Flow merchant endpoints) will be added in the phase that
# introduces GOAT AgentKit integration, using values from the official
# GOAT documentation.

# GOAT testnet connectivity (packages/agent-kit, scripts/check-goat-network.mjs).
# Verified official network parameters; see docs/development.md and
# docs/research/goat-technical-research.md.
#
# The active network defaults to goat-testnet. GOAT mainnet is refused in
# development unless GOAT_ALLOW_MAINNET=1 (explicit production gate).
GOAT_NETWORK=goat-testnet
# RPC endpoint overrides; defaults are the verified official URLs.
GOAT_TESTNET_RPC_URL=
GOAT_MAINNET_RPC_URL=
# RPC request timeout for connectivity checks (milliseconds).
GOAT_RPC_TIMEOUT_MS=10000
# Set to 1 only after an explicit production gate to allow goat-mainnet in dev.
GOAT_ALLOW_MAINNET=0

# GOAT AgentKit integration (packages/agent-kit). Safe local-development
# defaults; see docs/development.md.
AGENTKIT_IDEMPOTENCY_MODE=memory
AGENTKIT_REDIS_URL=
AGENTKIT_METRICS_PORT=9464
AGENTKIT_NETWORKS=goat-testnet
AGENTKIT_MAX_RISK_WITHOUT_CONFIRM=low
AGENTKIT_WRITE_ENABLED=true
